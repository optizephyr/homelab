# Caddy obtains and renews public certificates automatically.
# All hostnames below must resolve to this host, and ports 80/443 must be open.

uptime.{$CADDY_DOMAIN} {
	reverse_proxy uptime-kuma:3001
}

bark.{$CADDY_DOMAIN} {
	reverse_proxy bark-server:8080
}

monitor.{$CADDY_DOMAIN} {
	reverse_proxy beszel:8090
}

qinglong.{$CADDY_DOMAIN} {
	reverse_proxy qinglong:5700
}

terminal.{$CADDY_DOMAIN} {
	reverse_proxy termix:8080
}

caldav.{$CADDY_DOMAIN} {
	redir /.well-known/caldav / 301
	redir /.well-known/carddav / 301

	reverse_proxy radicale:5232
}
