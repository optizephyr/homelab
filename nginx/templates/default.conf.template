# Generated from templates/default.conf.template via nginx image envsubst.
# Subdomains: <service>.${DOMAIN} → containers on the homelab network.
# Upstream hostnames resolve at request time (Docker DNS) so disabled
# profiles do not block nginx from starting.

# Docker embedded DNS
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80 default_server;
    server_name _;

    location / {
        return 200 'homelab-stack nginx ok\n';
        add_header Content-Type text/plain;
    }
}

# uptime-kuma → https://uptime.${DOMAIN}
server {
    listen 80;
    server_name uptime.${DOMAIN};

    location / {
        set $upstream http://uptime-kuma:3001;
        proxy_pass $upstream;
        include /etc/nginx/snippets/proxy_params.conf;
    }
}

