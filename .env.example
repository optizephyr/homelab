# Copy to .env on the server (never commit .env)
#   cp .env.example .env && chmod 600 .env
#
# Naming: service-owned vars use SERVICE_ prefix. Shared stack keys stay unprefixed.
# Container env names (what an image reads) may differ; compose maps from these.

# Comma-separated Compose profiles for THIS machine.
# Required on every non-edge host: caddy
# If BESZEL_ENABLE=true, also required: beszel-agent (not the hub profile)
#
# scripts/up.sh deploys the selected profiles in dependency order:
# foundation (caddy) -> core services -> integrations.
# It pauses before integrations until the confirmation variables below are set.
#
#   1  Baseline + panels (no Mailhub / EasyTier secrets needed):
#      caddy,beszel,uptime-kuma,bark,qinglong,radicale,termix,tailscale-derp
#      `beszel` is the hub only. Create this host's agent token in the hub UI,
#      plus Radicale collections, after this stage.
#   2  After the hub has issued this host's token:  ,beszel-agent
#   3  After EASYTIER_NETWORK_NAME / SECRET:  ,easytier-relay
#   4  After Bark device key + Radicale「秋招」calendars:  ,mailhub
PROFILES=caddy

# Persistent bind-mount root for all services. Default: <repo>/data
# Must be an absolute path if set (included compose files resolve ./ relative to themselves).
# DATA_ROOT=/var/lib/homelab

# --- caddy ---
# Public base domain (Caddy site = <service>.${CADDY_DOMAIN})
#   uptime / bark / monitor / qinglong / terminal / caldav .${CADDY_DOMAIN}
CADDY_DOMAIN=example.com

# --- qinglong ---
# Panel base path (optional; default /). Must start and end with /.
# QINGLONG_BASE_URL=/

# --- mailhub ---
# Required when the mailhub profile is enabled.
# Prebuilt image on Aliyun ACR (or another registry). Do not build from GitHub.
# MAILHUB_IMAGE=registry.cn-hangzhou.aliyuncs.com/optizephyr/mailhub:latest
# MAILHUB_QQ_EMAIL=example@qq.com
# MAILHUB_QQ_AUTH_CODE=
# MAILHUB_TZ=Asia/Shanghai
# MAILHUB_INTERVAL_SECONDS=900
#
# Optional CalDAV channel. Same-host Radicale can use http://radicale:5232.
# MAILHUB_CALDAV_URL=http://radicale:5232
# MAILHUB_CALDAV_USERNAME=
# MAILHUB_CALDAV_PASSWORD=
# Set true only after calendar_name / reminders_list from config.yaml exist.
# MAILHUB_CALDAV_SETUP_CONFIRMED=false
#
# Optional OpenAI Chat Completions compatible API; set both values to enable.
# MAILHUB_LLM_API_BASE=
# MAILHUB_LLM_API_KEY=
#
# Optional Bark channel. Same-host bark-server can use http://bark-server:8080.
# MAILHUB_BARK_SERVER_URL=http://bark-server:8080
# MAILHUB_BARK_KEY=
#
# Set true only after list-calendars, list-reminders and sync --dry-run pass.
# MAILHUB_DRY_RUN_CONFIRMED=false

# --- beszel hub (profile: beszel) ---
# Web UI on a minority of hosts. Reverse-proxied at monitor.${CADDY_DOMAIN}.
# No extra env vars; enable with PROFILES containing `beszel`.
# Hub-only machine: PROFILES=caddy,beszel  (agent comes later, or on other hosts)

# --- beszel agent (profile: beszel-agent) ---
# Required on every host that joins the Beszel fleet, including the hub host.
# When true, bootstrap requires `beszel-agent` in PROFILES (not `beszel`).
BESZEL_ENABLE=true
# Agent-only machine: PROFILES=caddy,beszel-agent
# Hub+agent machine:  PROFILES=caddy,beszel,beszel-agent
# BESZEL_HUB_URL=https://monitor.example.com
# BESZEL_TOKEN=

# --- easytier-relay ---
# EASYTIER_NETWORK_NAME=
# EASYTIER_NETWORK_SECRET=
# Set true after reviewing command flags and opening the required firewall ports.
# EASYTIER_SETUP_CONFIRMED=true

# --- tailscale-derp ---
# TAILSCALE_DERP_DOMAIN=derp.example.com
# TAILSCALE_DERP_VERIFY_CLIENTS=true

# --- edge (docs only; not read by compose) ---
# BARK_EDGE_URL=https://bark.example.com
# FLAREWATCH_URL=https://status.example.com
