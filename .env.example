# Copy to .env on the server (never commit .env)
#   cp .env.example .env && chmod 600 .env

# Comma-separated Compose profiles for THIS machine.
# Required on every non-edge host: caddy
# If ENABLE_BESZEL=true, also required: beszel-agent
#
# Examples:
#   PROFILES=caddy
#   PROFILES=caddy,beszel-agent,uptime-kuma,bark
#   PROFILES=caddy,beszel-agent,qinglong
#   PROFILES=caddy,beszel-agent,easytier-relay
PROFILES=caddy

# Qinglong panel base path (optional; default /)
# QINGLONG_BASE_URL=/

# When true, bootstrap requires beszel-agent in PROFILES on this host
ENABLE_BESZEL=false

# Public base domain (Caddy site = <service>.${DOMAIN})
#   uptime / bark / monitor / qinglong / terminal / caldav .${DOMAIN}
DOMAIN=example.com

# Beszel agent (when ENABLE_BESZEL=true)
# BESZEL_HUB_URL=https://monitor.example.com
# BESZEL_TOKEN=

# Optional: edge standby endpoints (docs only)
# BARK_EDGE_URL=https://bark.example.com
# FLAREWATCH_URL=https://status.example.com
